generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  relationMode = "prisma"
  extensions = [vector]
}

model documents {
  id        BigInt                 @id @default(autoincrement())
  content   String?
  embedding  Unsupported("vector(1536)")?
}
